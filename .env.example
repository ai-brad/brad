# ==============================================================================
# BRAD CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual values
# For detailed setup instructions, see README.md

# ==============================================================================
# JIRA CONFIGURATION (Required)
# ==============================================================================
# Set BRAD_TICKETING=dummy to bypass Jira entirely for local summary smokes.
# In that mode Brad reads a local fixture from BRAD_DUMMY_TICKET_PATH and
# appends issue updates to BRAD_DUMMY_TICKET_LOG_PATH.
# BRAD_TICKETING=dummy
# BRAD_DUMMY_TICKET_PATH=/path/to/dummy_ticket.txt
# BRAD_DUMMY_TICKET_LOG_PATH=/path/to/dummy_ticket.log

# Your Jira Cloud instance URL
# Example: https://yourcompany.atlassian.net
# How to find: Visit your Jira dashboard and copy the base URL from your browser
JIRA_URL=https://your-company.atlassian.net

# Your Jira account email address
# Example: john.doe@company.com
JIRA_USER=your-email@company.com

# Jira API token (NOT your password)
# How to create:
#   1. Visit https://id.atlassian.com/manage-profile/security/api-tokens
#   2. Click "Create API token"
#   3. Give it a name like "Brad Bot"
#   4. Copy the generated token and paste it here
# Docs: https://support.atlassian.com/atlassian-account/docs/manage-api-tokens-for-your-atlassian-account/
JIRA_TOKEN=your-jira-api-token

# Jira project key (the prefix in your issue IDs)
# Example: If your issues are DEV-1234, DEV-5678, use "DEV"
# How to find: Open any issue in your project, the key is before the dash
JIRA_PROJECT_KEY=DEV

# ==============================================================================
# GITHUB CONFIGURATION (Required)
# ==============================================================================
# Choose ONE auth mode:
#
# 1. Preferred: GitHub App installation auth
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=78901234
# GITHUB_APP_PRIVATE_KEY_PATH=/home/you/.config/brad-github-app/flaero-brad-bot.private-key.pem
#
# Alternative: GitHub token auth
# GITHUB_TOKEN=your-github-token
#
# If you set both, Brad prefers the GitHub App credentials.

# GitHub repository in owner/repo format
# Example: facebook/react, torvalds/linux, yourorg/yourrepo
# This is the repo where Brad will create pull requests
GITHUB_REPO=owner/repo-name

# Require Brad to trust GitHub comment author identity, not just a `Brad ...`
# text prefix, when deciding whether a PR comment/review was already handled.
# Leave this true unless you explicitly need legacy prefix-only behavior.
# GITHUB_REQUIRE_BRAD_AUTHOR_IDENTITY=true

# Optional comma-separated fallback allowlist for Brad-authored GitHub logins.
# This is mostly useful during migrations or non-App auth setups.
# Example: GITHUB_BRAD_AUTHOR_LOGINS=flaero-brad-bot[bot]
# GITHUB_BRAD_AUTHOR_LOGINS=

# ==============================================================================
# TARGET REPOSITORY (Required)
# ==============================================================================
# Absolute path to the local git clone Brad will work on.
# OPTIONAL: If unset, Brad self-bootstraps a clone of GITHUB_REPO under
# BRAD_WORKSPACE_DIR (see below) using the configured GitHub auth mode.
# Set this only if you want Brad to reuse an existing checkout.
# Example: /home/you/projects/yourrepo
# TARGET_REPO_PATH=

# Root directory where Brad will place self-bootstrapped target repo clones.
# Default: ~/.brad/workspaces
# The actual clone lives at $BRAD_WORKSPACE_DIR/<owner>-<repo>.
# BRAD_WORKSPACE_DIR=

# ==============================================================================
# TARGET REPO PROVISIONING (Optional but often required)
# ==============================================================================
# Path to an executable shell script that Brad runs once after cloning the
# target repo for the first time (and again if the clone is ever recreated).
# Brad passes the absolute path to the clone as the first argument ($1).
#
# Use this to drop the target repo's own .env file, start companion services
# (e.g. docker compose up -d), or do any other one-time workspace setup that
# the target project needs before its tests can run.
#
# The script lives on the server that runs Brad and must NEVER be committed to
# any version-controlled repository.  A typical setup:
#
#   1. Create ~/.brad/hooks/provision-target.sh:
#
#        #!/bin/bash
#        set -euo pipefail
#        TARGET_PATH="$1"
#        # Copy the project's own secrets into the cloned workspace:
#        cp ~/.brad/secrets/my-project.env "$TARGET_PATH/.env"
#        # Optionally start services the test suite needs:
#        # docker compose -f "$TARGET_PATH/docker-compose.yml" up -d
#
#   2. Make it executable:
#        chmod 700 ~/.brad/hooks/provision-target.sh
#
#   3. Point Brad at it:
#        TARGET_REPO_PROVISION_HOOK=/home/you/.brad/hooks/provision-target.sh
#
# If the script exits non-zero, Brad logs an error and continues — it does not
# abort, because an already-provisioned workspace (e.g. after a manual scp)
# should still work.  Make the script idempotent.
# TARGET_REPO_PROVISION_HOOK=

# ==============================================================================
# AGENT HARNESS (Optional - Defaults Shown)
# ==============================================================================
# Which agentic loop drives the model.
#   "brad"  — Brad's native tool-calling loop (uses BRAD_LLM_PROVIDER below).
#   "codex" — Delegate to OpenAI's `codex` CLI (must be installed and authed).
# BRAD_HARNESS=brad

# Inner LLM provider (only consulted when BRAD_HARNESS=brad).
#   "azure_openai" — Azure OpenAI Responses API (configured below).
# BRAD_LLM_PROVIDER=azure_openai

# Codex CLI configuration (only used when BRAD_HARNESS=codex).
# Install: https://github.com/openai/codex
# CODEX_BIN=codex
# CODEX_MODEL=                        # optional override; if unset, codex uses ~/.codex/config.toml
# CODEX_SUMMARIZATION_MODEL=          # optional override for restart-summary compaction; defaults to CODEX_MODEL
# CODEX_SANDBOX=workspace-write       # read-only | workspace-write | danger-full-access
# CODEX_APPROVAL=danger               # danger (default) | full-auto | sandbox-only
#                                     # 'danger' = --dangerously-bypass-approvals-and-sandbox.

# ==============================================================================
# EXECUTION LIVENESS / STALE STATE RECOVERY (Optional)
# ==============================================================================
# Heartbeat interval for active executions. Brad updates execution liveness on a
# background timer while work is in progress.
# EXECUTION_HEARTBEAT_INTERVAL_SECONDS=30

# How old a heartbeat/progress timestamp can be before the GUI stops treating a
# `running` execution as live. Startup reconciliation also uses this as a stale
# threshold when worker ownership alone is not enough.
# EXECUTION_STALE_THRESHOLD_SECONDS=300

# How often Brad logs current/peak worker RSS for OOM diagnostics.
# EXECUTION_MEMORY_LOG_INTERVAL_SECONDS=300

# Current deployment assumes a single worker process owns execution state.
# Leave this unset/false unless Brad is redesigned for concurrent workers.
# BRAD_ALLOW_CONCURRENT_WORKERS=false
#                                     # Required so the agent can `git push` and `gh pr create`
#                                     # (both blocked by --full-auto's network+.git sandbox).
# CODEX_TIMEOUT=3600                  # seconds per task

# ==============================================================================
# AZURE OPENAI CONFIGURATION (Required when BRAD_HARNESS=brad)
# ==============================================================================
# Azure OpenAI endpoint URL (FULL URL including deployment and api-version)
# Format: https://{resource-name}.openai.azure.com/openai/deployments/{deployment-name}/responses?api-version=2025-03-01-preview
# Example: https://my-openai.openai.azure.com/openai/deployments/gpt-4o/responses?api-version=2025-03-01-preview
# How to find:
#   1. Go to Azure Portal > Azure OpenAI Service > Your resource
#   2. Click "Keys and Endpoint"
#   3. Copy the endpoint and append /openai/deployments/{your-deployment}/responses?api-version=2025-03-01-preview
# Docs: https://learn.microsoft.com/en-us/azure/ai-services/openai/quickstart
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/deployments/your-deployment/responses?api-version=2025-03-01-preview

# Azure OpenAI API key
# How to find: Azure Portal > Azure OpenAI Service > Your resource > Keys and Endpoint > KEY 1
AZURE_OPENAI_API_KEY=your-azure-openai-api-key

# Azure OpenAI model/deployment name
# Common values: gpt-4o, gpt-4, gpt-35-turbo
# This should match the deployment name in your Azure OpenAI resource
AZURE_OPENAI_MODEL=gpt-4o

# ==============================================================================
# COST TRACKING (Optional but Recommended)
# ==============================================================================
# Cost per 1,000 prompt tokens (input tokens)
# Check Azure OpenAI pricing: https://azure.microsoft.com/en-us/pricing/details/cognitive-services/openai-service/
# gpt-4o: $0.005 per 1K prompt tokens
# gpt-4: $0.03 per 1K prompt tokens
LLM_COST_PER_1K_PROMPT_TOKENS=0.005

# Cost per 1,000 completion tokens (output tokens)
# gpt-4o: $0.015 per 1K completion tokens
# gpt-4: $0.06 per 1K completion tokens
LLM_COST_PER_1K_COMPLETION_TOKENS=0.015

# Maximum cost budget per issue (in dollars)
# Brad will warn if an issue exceeds this cost
COST_BUDGET=3.0

# ==============================================================================
# SAFETY LIMITS (Optional - Defaults Shown)
# ==============================================================================
# Maximum times Brad will ask for clarification on requirements
MAX_CLARIFICATION_CYCLES=3

# Maximum times Brad will attempt to fix CI/CD failures
MAX_CI_FIX_ITERATIONS=5

# Maximum times Brad will address code review comments
MAX_REVIEW_FIX_ITERATIONS=3

# Maximum retries for flaky tests
MAX_FLAKY_RETRIES=1

# CI/CD polling interval in seconds (how often Brad checks CI status)
CI_POLL_INTERVAL=60

# ==============================================================================
# DATABASE (Optional - Defaults Shown)
# ==============================================================================
# SQLite database file path for execution history and cost tracking
# Can be absolute or relative path
BRAD_DB_PATH=brad_data.db

# ==============================================================================
# LOGGING (Optional - Defaults Shown)
# ==============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directory for storing downloaded Jira attachments
ATTACHMENTS_DIR=./attachments

# ==============================================================================
# AZURE AKS DEPLOYMENT MONITORING (Optional)
# ==============================================================================
# Only needed if you want Brad to monitor deployment health on Azure Kubernetes Service
# Leave empty to skip deployment monitoring

# Azure service principal credentials as JSON string
# How to create: https://learn.microsoft.com/en-us/azure/aks/kubernetes-service-principal
# Leave empty if not using deployment monitoring
AZURE_CREDENTIALS_JSON=

# Azure resource group name containing your AKS cluster
AZURE_RESOURCE_GROUP=your-resource-group

# Azure AKS cluster name
AZURE_AKS_CLUSTER=your-aks-cluster

# Comma-separated list of deployment names to monitor
# Example: api-service,web-frontend,worker-service
AZURE_DEPLOYMENTS=deployment1,deployment2

# Whether to check deployment health after CI passes
DEPLOYMENT_HEALTH_CHECK=true

# Number of log lines to fetch from pods
DEPLOYMENT_LOG_TAIL_LINES=200

# Time window for fetching logs (e.g., 10m, 1h, 30s)
DEPLOYMENT_LOG_SINCE=10m
