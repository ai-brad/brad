# Brad Configuration Example
# Copy this file to .env and fill in your actual values

# JIRA Configuration
JIRA_URL=https://your-company.atlassian.net
JIRA_USER=your-email@company.com
JIRA_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=DEV

# GitHub Configuration
GITHUB_TOKEN=your-github-token-here
GITHUB_REPO=owner/repository-name

# Target Repository (the repo Brad will work on - must be absolute path)
TARGET_REPO_PATH=C:\path\to\target\repository

# AI Agent Configuration
# Options: "claude" or "opencode"
AI_AGENT=claude

# Claude CLI Configuration
CLAUDE_CLI_PATH=claude

# OpenCode CLI Configuration
OPENCODE_CLI_PATH=C:\Users\lukas\AppData\Roaming\npm\opencode.cmd
# Model to use with OpenCode (e.g., claude-sonnet-4.5-20250514, grok-2-latest)
OPENCODE_MODEL=claude-sonnet-4.5-20250514

# Safety Limits
MAX_CLARIFICATION_CYCLES=3
MAX_CI_FIX_ITERATIONS=5
MAX_FLAKY_RETRIES=1
CI_POLL_INTERVAL=60

# Logging
LOG_LEVEL=INFO
ATTACHMENTS_DIR=./attachments
