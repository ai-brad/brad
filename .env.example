# =============================================================================
# Brad Configuration
# Copy this file to .env and fill in your actual values.
#
# IMPORTANT: Secrets (.env) should NEVER be committed to source control.
#            Non-secret configuration can live in config files or env vars.
# =============================================================================

# ---------------------------------------------------------------------------
# CONFIGURATION (non-secret — safe to share across environments)
# ---------------------------------------------------------------------------

# JIRA
JIRA_URL=https://your-company.atlassian.net
JIRA_USER=your-email@company.com
JIRA_PROJECT_KEY=DEV

# GitHub
GITHUB_REPO=flaerobotics/bea

# Target repository (absolute path to the repo Brad works on)
TARGET_REPO_PATH=C:\git\bea

# Azure OpenAI — model/deployment name
#   Use the model name as deployed in your Azure OpenAI resource.
AZURE_OPENAI_MODEL=gpt-5.2-codex

# Azure / AKS (deployment log monitoring)
#   Resource group and cluster name for the AKS environment Brad monitors.
AZURE_RESOURCE_GROUP=TEST
AZURE_AKS_CLUSTER=bea-test2

# Deployment monitoring
DEPLOYMENT_HEALTH_CHECK=true
DEPLOYMENT_LOG_TAIL_LINES=200
DEPLOYMENT_LOG_SINCE=10m

# Safety limits
MAX_CLARIFICATION_CYCLES=3
MAX_CI_FIX_ITERATIONS=5
MAX_REVIEW_FIX_ITERATIONS=3
MAX_FLAKY_RETRIES=1
CI_POLL_INTERVAL=60

# Logging
LOG_LEVEL=INFO
ATTACHMENTS_DIR=./attachments

# ---------------------------------------------------------------------------
# SECRETS (keep these private — never commit to source control)
# ---------------------------------------------------------------------------

# JIRA API Token
#   Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
#   1. Log in with your Atlassian account
#   2. Click "Create API token", give it a label (e.g. "Brad")
#   3. Copy the token here
JIRA_TOKEN=

# GitHub Personal Access Token
#   Generate at: https://github.com/settings/tokens
#   1. Click "Generate new token (classic)"
#   2. Required scopes: repo, workflow
#   3. Copy the token here
GITHUB_TOKEN=

# Azure OpenAI — endpoint URL (includes deployment name and API version)
#   Find in: Azure Portal → your Azure OpenAI resource → Keys and Endpoint
#   Format: https://<resource-name>.openai.azure.com/openai/deployments/<deployment-name>/responses?api-version=2025-03-01-preview
#   How to get:
#   1. Go to https://portal.azure.com → Azure OpenAI → your resource
#   2. Under "Resource Management" → "Keys and Endpoint", copy the endpoint
#   3. Append: /openai/deployments/<your-deployment>/responses?api-version=2025-03-01-preview
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI — API key
#   Find in: Azure Portal → your Azure OpenAI resource → Keys and Endpoint
#   Copy either Key 1 or Key 2
AZURE_OPENAI_API_KEY=

# Azure Service Principal Credentials (for AKS log monitoring)
#   Create a service principal: az ad sp create-for-rbac --name "brad-sp" --role reader --scopes /subscriptions/<sub-id>
#   Format: {"clientId":"...","clientSecret":"...","tenantId":"...","subscriptionId":"..."}
AZURE_CREDENTIALS_JSON=
